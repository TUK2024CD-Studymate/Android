<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".HomeFragment.SearchFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="@string/startMatching"
            android:gravity="center"
            android:textSize="28sp"
            android:textColor="@color/black"
            android:textStyle="bold"/>


        <Spinner
            android:id="@+id/spinner1"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:theme="@style/SpinnerTheme"
            android:background="@drawable/edit_black"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal" />
        
        <EditText
            android:id="@+id/specifyField"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:paddingStart="15dp"
            android:textSize="14sp"
            android:background="@drawable/edit_black"
            android:textColorHint="@color/lightGray"
            android:hint="상세분야를 적어주세요"/>

        <EditText
            android:id="@+id/titleEdit"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:textSize="14sp"
            android:paddingStart="15sp"
            android:background="@drawable/edit_black"
            android:textColorHint="@color/lightGray"
            android:hint="@string/searchTitle"/>

        <EditText
            android:id="@+id/contentEdit"
            android:layout_width="300dp"
            android:layout_height="180dp"
            android:paddingStart="15dp"
            android:layout_marginTop="20dp"
            android:paddingTop="15dp"
            android:textSize="14sp"
            android:gravity="top"
            android:background="@drawable/edit_black"
            android:textColorHint="@color/lightGray"
            android:hint="@string/mentoQuestion"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/searchMento"
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:background="@drawable/next_button"
            android:textColor="@color/white"
            style="?android:attr/borderlessButtonStyle"
            android:text="@string/matchingStart"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>






</LinearLayout>